# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored; .env.example is committed as documentation.

# ElevenLabs (text-to-speech)
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=

# Optional per-language voice overrides
VITE_ELEVENLABS_VOICE_ID_EN=
VITE_ELEVENLABS_VOICE_ID_AR=

# LLM
VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini

# Vision LLM (Smart Receipt). Inherits VITE_LLM_API_URL/KEY when blank.
VITE_VISION_API_URL=
VITE_VISION_API_KEY=
VITE_VISION_MODEL=gpt-4o-mini
